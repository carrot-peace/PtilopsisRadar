# Ptilopsis Radar container environment
# Copy to docker/.env and fill only the channels you use. Never commit secrets.

TZ=Asia/Shanghai
WEBSERVER_PORT=8080
RUN_MODE=cron
CRON_SCHEDULE=*/30 * * * *
IMMEDIATE_RUN=true

# Shared AI endpoint. The checked-in config remains the fallback for blank values.
AI_ANALYSIS_ENABLED=
AI_API_KEY=
AI_MODEL=
AI_API_BASE=

# DR-specific generation budget. These do not change translation/output budgets.
AI_ANALYSIS_MAX_OUTPUT_TOKENS=16000
AI_ANALYSIS_MAX_EVENTS=30
AI_ANALYSIS_BATCH_MAX_EVIDENCE=12

# CR and DR dispatch are independently gated. Keep off until explicitly enabled.
PTILOPSIS_CR_DISPATCH_MODE=off
PTILOPSIS_CR_TELEGRAM_SEND=0
PTILOPSIS_CR_TELEGRAM_BOT_TOKEN=
PTILOPSIS_CR_TELEGRAM_CHAT_ID=
PTILOPSIS_CR_TELEGRAM_API_BASE_URL=
PTILOPSIS_CR_TELEGRAM_TIMEOUT_SECONDS=10
PTILOPSIS_CR_TELEGRAM_PARSE_MODE=
PTILOPSIS_CR_TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=true

PTILOPSIS_DR_DISPATCH_MODE=off
PTILOPSIS_DR_TELEGRAM_SEND=0
PTILOPSIS_DR_TELEGRAM_BOT_TOKEN=
PTILOPSIS_DR_TELEGRAM_CHAT_ID=
PTILOPSIS_DR_TELEGRAM_ATTACH_HTML=1
PTILOPSIS_DR_TELEGRAM_API_BASE_URL=
PTILOPSIS_DR_TELEGRAM_TIMEOUT_SECONDS=10
PTILOPSIS_DR_TELEGRAM_PARSE_MODE=HTML

# Owner-only operational notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_CHAT_IDS=

# Optional S3-compatible publication storage.
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
